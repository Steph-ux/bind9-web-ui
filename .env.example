# Server
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# Session
# Mandatory in production. Random in development if omitted.
SESSION_SECRET=

# Bootstrap admin
# Used only when the admin user does not exist yet.
DEFAULT_ADMIN_PASSWORD=

# Database
# sqlite (default) | postgresql | mysql
DB_TYPE=sqlite
# SQLite: path relative to project root
# PostgreSQL: postgresql://user:pass@host:5432/dbname
# MySQL: mysql://user:pass@host:3306/dbname
DATABASE_URL=data/bind9admin.db

# Runtime backups
BACKUP_DIR=data/backups

# BIND9 local mode
BIND9_CONF_DIR=/etc/bind
BIND9_ZONE_DIR=/var/cache/bind
RNDC_BIN=rndc
NAMED_CHECKCONF=named-checkconf
